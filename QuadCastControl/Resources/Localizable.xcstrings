{
  "sourceLanguage": "en",
  "strings": {
    "discovery.appTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuadCast Control"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QuadCast Control"
          }
        }
      }
    },
    "discovery.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить"
          }
        }
      }
    },
    "discovery.scanning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking for microphones…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск микрофонов…"
          }
        }
      }
    },
    "discovery.disconnected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone connected"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон не подключён"
          }
        }
      }
    },
    "discovery.connectHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your HyperX microphone via USB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите микрофон HyperX по USB."
          }
        }
      }
    },
    "discovery.connectedUSB": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected via USB"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключён по USB"
          }
        }
      }
    },
    "discovery.errorTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to check the connection"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить подключение"
          }
        }
      }
    },
    "discovery.errorDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio device list is unavailable. Try refreshing it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список аудиоустройств недоступен. Попробуйте обновить его."
          }
        }
      }
    },
    "discovery.manualRefreshHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic updates are unavailable. Use Refresh after connecting or disconnecting a microphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автообновление недоступно. После подключения или отключения микрофона нажмите «Обновить»."
          }
        }
      }
    },
    "hid.connected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HID interface linked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HID-интерфейс связан"
          }
        }
      }
    },
    "hid.accessUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HID access is unavailable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HID-интерфейс недоступен"
          }
        }
      }
    },
    "hid.notLinked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HID interface not linked"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HID-интерфейс не связан"
          }
        }
      }
    },
    "lighting.turnOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off lighting"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить подсветку"
          }
        }
      }
    },
    "lighting.stop": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop lighting control"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить управление"
          }
        }
      }
    },
    "lighting.sending": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning off lighting…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключение подсветки…"
          }
        }
      }
    },
    "lighting.stopping": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping lighting control…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановка управления…"
          }
        }
      }
    },
    "lighting.offActive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighting-off control is active"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключение подсветки активно"
          }
        }
      }
    },
    "lighting.keepOpen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app open. Stopping control may restore the microphone’s own lighting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение должно оставаться открытым. После остановки управления микрофон может вернуть свою подсветку."
          }
        }
      }
    },
    "lighting.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone’s lighting interface could not be identified. Reconnect it and refresh."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить интерфейс подсветки. Переподключите микрофон и обновите список."
          }
        }
      }
    },
    "lighting.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This lighting interface is not supported by the current protocol."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот интерфейс подсветки пока не поддерживается."
          }
        }
      }
    },
    "lighting.accessDenied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USB access was denied or the lighting interface is in use. Close other microphone utilities and retry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "USB-доступ запрещён или интерфейс подсветки занят. Закройте другие утилиты микрофона и повторите."
          }
        }
      }
    },
    "lighting.disconnected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone was disconnected. Reconnect it before trying again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон отключён. Подключите его перед повторной попыткой."
          }
        }
      }
    },
    "lighting.transferFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not send the lighting command. Control has stopped; try reconnecting the microphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить команду подсветки. Управление остановлено; попробуйте переподключить микрофон."
          }
        }
      }
    },
    "lighting.openFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the lighting USB interface. Check USB permissions and close other microphone utilities."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть USB-интерфейс подсветки. Проверьте USB-разрешения и закройте другие утилиты микрофона."
          }
        }
      }
    }
  },
  "version": "1.0"
}
