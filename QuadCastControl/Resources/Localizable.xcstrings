    "discovery.connectedUSB" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connected via USB"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключён по USB"
